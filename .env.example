# Archivo de ejemplo para variables de entorno
# Copia este archivo a `.env` y completa con tus credenciales reales de Supabase
# NUNCA subas el archivo `.env` al repositorio (ya está en .gitignore)

# URL de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Claves de API de Supabase (opcional para el cliente web)
SUPABASE_ANON_KEY=tu-clave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui

# Credenciales de la base de datos PostgreSQL (para conexión directa desde ETL/scripts)
# IMPORTANTE: Usar el pooler (puerto 6543) en lugar del puerto directo (5432) para mejor compatibilidad
SUPABASE_DB_HOST=db.tu-proyecto.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.tu-proyecto
SUPABASE_DB_PASSWORD=tu-password-aqui
