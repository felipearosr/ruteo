# Variables de entorno para la aplicación Next.js
# Copia este archivo a `.env.local` y completa con tus credenciales reales
# NUNCA subas el archivo `.env.local` al repositorio

# Para el cliente (navegador) - variables públicas con prefijo NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Para las API routes (servidor) - conexión directa a PostgreSQL
SUPABASE_DB_HOST=db.tu-proyecto.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.tu-proyecto
SUPABASE_DB_PASSWORD=tu_password_aqui
