# Variables de entorno para Docker Compose
# Copia este archivo a `.env` en la raíz del proyecto antes de ejecutar docker-compose
# NUNCA subas el archivo `.env` al repositorio

# URL de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Claves de API de Supabase
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Credenciales de la base de datos PostgreSQL
# Usa connection pooler (puerto 6543) para mejor compatibilidad
SUPABASE_DB_HOST=db.tu-proyecto.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.tu-proyecto
SUPABASE_DB_PASSWORD=tu_password_aqui
